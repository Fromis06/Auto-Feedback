# ==============================================================================
# autopatch-engine Environment Configuration
# Copy to .env via `make init` and replace placeholder credentials.
# ==============================================================================

# --- Target Repository & GitHub Integration ---
# HTTPS clone URL of the repository to patch automatically
TARGET_REPO_URL=https://github.com/your-org/your-app.git
# Fine-grained PAT with Contents (read/write) & Pull Requests (read/write) scopes
GITHUB_TOKEN=ghp_your_github_token_here
# Secret configured on your GitHub repository webhook (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
# Base branch for PR targets, version staleness checks, and auto-rebasing
BASE_BRANCH=main

# --- Sandbox Container Configuration ---
# Base Docker image used to build the ephemeral autopatch-sandbox image
SANDBOX_BASE_IMAGE=node:20-slim
# Tag of the built sandbox image launched by the orchestrator
SANDBOX_IMAGE=autopatch-sandbox:latest

# --- Zero-Config LLM Provider (OpenAI, Gemini, Ollama, or vLLM) ---
# Just supply LLM_BASE_URL and LLM_API_KEY! Known host suffixes are auto-normalized:
#   OpenAI: https://api.openai.com/v1
#   Gemini: https://generativelanguage.googleapis.com   (auto-adds /v1beta/openai)
#   Ollama: http://host.docker.internal:11434           (auto-adds /v1)
#   vLLM:   http://host.docker.internal:8000            (auto-adds /v1)
LLM_BASE_URL=https://api.openai.com/v1
# API key (for local Ollama/vLLM, any non-empty placeholder such as "ollama" works)
LLM_API_KEY=sk-your-llm-api-key-here
# Leave as "auto" to discover and assign optimal models from GET {LLM_BASE_URL}/models on startup.
# Override any individual slot with a concrete model ID if desired.
EMBEDDING_MODEL=auto
VECTOR_DIM=768
TRIAGE_MODEL=auto
CODING_MODEL=auto

# --- Deduplication & Blast-Radius Guardrails ---
# Cosine similarity threshold (0.0 - 1.0) to merge duplicate feedback reports
SIMILARITY_THRESHOLD=0.85
# Comma-separated file/directory prefixes the sandbox agent is forbidden from modifying
PROTECTED_PATHS=.env,docker-compose.yml,.github/workflows
# Maximum total added + deleted lines allowed per automated patch
MAX_DIFF_LINES=200
# Regression test command executed inside the sandbox before opening a PR
TEST_COMMAND=npm test

# --- Remote Admin Dashboard & Auth (/dashboard, /api/v1/tickets, /api/v1/stats) ---
# Username for HTTP Basic Auth on Admin routes (default: admin)
ADMIN_USER=admin
# Optional password protecting /dashboard and Admin REST API (Basic Auth or Bearer token).
# Strongly recommended whenever exposing the dashboard remotely. Leave empty for open local dev.
ADMIN_PASSWORD=

# --- ChatOps Webhook Notifications (Discord / Slack / Generic JSON) ---
# Optional webhook URL (Discord discord.com/api/webhooks/... or Slack incoming webhook).
# Leave empty to disable outbound notifications.
ALERT_WEBHOOK_URL=
# Optional public URL to your dashboard included in alert notifications (e.g. https://autopatch.example.com/dashboard)
PUBLIC_DASHBOARD_URL=

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=autopatch
POSTGRES_PASSWORD=autopatch
POSTGRES_DB=autopatch
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Orchestrator HTTP Server ---
ORCHESTRATOR_PORT=8080
CORS_ALLOWED_ORIGIN=*
